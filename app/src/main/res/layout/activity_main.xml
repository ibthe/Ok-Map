<?xml version="1.0" encoding="utf-8"?>
<!-- Geometry: 4 dp grid, 16 dp screen margin on all four sides, 8 dp between stacked blocks,
     12 dp between neighbouring controls, 48 dp touch targets, 56 dp primary controls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- crosshair: the point shown in the info chip and saved by the primary button -->
    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_crosshair" />

    <!-- top: search, results, coordinates -->
    <LinearLayout
        android:id="@+id/topColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_lg"
            android:background="@drawable/bg_panel_pill"
            android:elevation="6dp"
            android:paddingBottom="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon"
                android:layout_height="@dimen/icon"
                android:layout_marginStart="@dimen/space_4"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="@dimen/space_3"
                android:paddingEnd="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.G.Body"
                android:textColor="?attr/gTextPrimary"
                android:textColorHint="?attr/gHint" />

            <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="@dimen/control_sm"
                android:layout_height="@dimen/control_sm"
                android:layout_marginEnd="@dimen/space_1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear"
                android:src="@drawable/ic_clear"
                android:visibility="gone" />
        </LinearLayout>

        <!-- quick filters for the road: one tap shows / hides a POI category -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="@dimen/space_1"
            android:paddingBottom="@dimen/space_2"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ListView
            android:id="@+id/lvResults"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="@dimen/space_1"
            android:background="@drawable/bg_panel_list"
            android:clipToOutline="true"
            android:divider="?attr/gStroke"
            android:dividerHeight="1dp"
            android:elevation="8dp"
            android:outlineProvider="background"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_marginTop="@dimen/space_2"
            android:background="@drawable/bg_panel"
            android:elevation="4dp"
            android:fontFeatureSettings="tnum"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.G.Caption"
            android:textColor="?attr/gTextSecondary" />

        <!-- ruler: shown while a ruler exists; tap a point to remove it, tap the map to add one -->
        <LinearLayout
            android:id="@+id/rulerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:background="@drawable/bg_panel_list"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_2"
            android:visibility="gone">

            <TextView
                android:id="@+id/rulerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.G.Label"
                android:textColor="?attr/gTextPrimary" />

            <TextView
                android:id="@+id/btnRulerUndo"
                android:layout_width="@dimen/control_sm"
                android:layout_height="44dp"
                android:background="@drawable/bg_fab_pill"
                android:clickable="true"
                android:contentDescription="Убрать последнюю точку"
                android:focusable="true"
                android:gravity="center"
                android:stateListAnimator="@animator/press"
                android:text="↶"
                android:textColor="?attr/gTextPrimary"
                android:textSize="20sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnRulerMode"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/space_2"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="@dimen/space_3"
                android:paddingEnd="@dimen/space_3"
                android:stateListAnimator="@animator/press"
                android:textAppearance="@style/TextAppearance.G.Label"
                android:textColor="?attr/gOnAccent" />

            <TextView
                android:id="@+id/btnRulerDelete"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/space_2"
                android:background="@drawable/bg_fab_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="@dimen/space_3"
                android:paddingEnd="@dimen/space_3"
                android:stateListAnimator="@animator/press"
                android:text="Удалить"
                android:textAppearance="@style/TextAppearance.G.Label"
                android:textColor="?attr/gCrosshair" />
        </LinearLayout>
    </LinearLayout>

    <!-- right: round map controls, right edge flush with the primary button below -->
    <LinearLayout
        android:id="@+id/rightControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="88dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnFit"
            android:layout_width="@dimen/control_sm"
            android:layout_height="@dimen/control_sm"
            android:background="@drawable/bg_fab"
            android:stateListAnimator="@animator/press"
            android:contentDescription="@string/btn_fit"
            android:elevation="6dp"
            android:src="@drawable/ic_fit" />

        <ImageButton
            android:id="@+id/btnLocation"
            android:layout_width="@dimen/control_sm"
            android:layout_height="@dimen/control_sm"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/bg_fab"
            android:stateListAnimator="@animator/press"
            android:contentDescription="@string/btn_location"
            android:elevation="6dp"
            android:src="@drawable/ic_my_location"
            app:tint="?attr/gAccent" />

        <ImageButton
            android:id="@+id/btnCompass"
            android:layout_width="@dimen/control_sm"
            android:layout_height="@dimen/control_sm"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/bg_fab"
            android:contentDescription="Компас"
            android:elevation="6dp"
            android:src="@drawable/ic_compass"
            android:stateListAnimator="@animator/press" />
    </LinearLayout>

    <!-- bottom: menu + primary action -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/control_lg"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/screen_margin"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="@dimen/control_lg"
            android:layout_height="@dimen/control_lg"
            android:background="@drawable/bg_fab"
            android:stateListAnimator="@animator/press"
            android:contentDescription="@string/btn_menu"
            android:elevation="6dp"
            android:src="@drawable/ic_menu" />

        <LinearLayout
            android:id="@+id/btnPoint"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:outlineSpotShadowColor="?attr/gAccentEdge"
            android:stateListAnimator="@animator/press"
            tools:targetApi="28"
            android:clickable="true"
            android:contentDescription="@string/btn_point"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon"
                android:layout_height="@dimen/icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_add_location"
                app:tint="?attr/gOnAccent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:text="@string/btn_point"
                android:textAppearance="@style/TextAppearance.G.Label"
                android:textColor="?attr/gOnAccent"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnRec"
            android:layout_width="@dimen/control_lg"
            android:layout_height="@dimen/control_lg"
            android:layout_marginStart="@dimen/space_3"
            android:background="@drawable/bg_fab"
            android:contentDescription="@string/btn_rec"
            android:elevation="6dp"
            android:src="@drawable/ic_rec"
            android:stateListAnimator="@animator/press" />
    </LinearLayout>

    <!-- navigation: next manoeuvre (top) -->
    <LinearLayout
        android:id="@+id/navTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:background="@drawable/bg_panel_list"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_3"
        android:visibility="gone">

        <TextView
            android:id="@+id/navArrow"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="?attr/gOnAccent"
            android:textSize="36sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/navDist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.G.Title"
                android:textColor="?attr/gTextPrimary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.G.Body"
                android:textColor="?attr/gTextSecondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- navigation / route preview: summary and buttons (replaces the dock) -->
    <LinearLayout
        android:id="@+id/navBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/screen_margin"
        android:background="@drawable/bg_panel_list"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_3"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/navStat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.G.Title"
                android:textColor="?attr/gTextPrimary" />

            <TextView
                android:id="@+id/navSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.G.Caption"
                android:textColor="?attr/gTextSecondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnNavCancel"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/control_lg"
            android:layout_marginStart="@dimen/space_2"
            android:background="@drawable/bg_fab_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="96dp"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4"
            android:stateListAnimator="@animator/press"
            android:text="Отмена"
            android:textAppearance="@style/TextAppearance.G.Label"
            android:textColor="?attr/gTextPrimary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnNavGo"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/control_lg"
            android:layout_marginStart="@dimen/space_2"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="112dp"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4"
            android:stateListAnimator="@animator/press"
            android:text="Поехали"
            android:textAppearance="@style/TextAppearance.G.Label"
            android:textColor="?attr/gOnAccent"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- compass mode -->
    <LinearLayout
        android:id="@+id/compassPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/screen_margin"
        android:background="@drawable/bg_panel_list"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="@dimen/space_3"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:text="Компас"
                android:textAppearance="@style/TextAppearance.G.Title"
                android:textColor="?attr/gTextPrimary" />

            <TextView
                android:id="@+id/btnCompassMap"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="@dimen/space_3"
                android:paddingEnd="@dimen/space_3"
                android:stateListAnimator="@animator/press"
                android:textAppearance="@style/TextAppearance.G.Caption"
                android:textColor="@color/chip_text" />

            <TextView
                android:id="@+id/btnCompassClose"
                android:layout_width="@dimen/control_sm"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/space_2"
                android:background="@drawable/bg_fab_pill"
                android:clickable="true"
                android:contentDescription="Закрыть компас"
                android:focusable="true"
                android:gravity="center"
                android:stateListAnimator="@animator/press"
                android:text="✕"
                android:textColor="?attr/gTextPrimary"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipNorth"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="@dimen/space_2"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:stateListAnimator="@animator/press"
                android:text="Север"
                android:textAppearance="@style/TextAppearance.G.Label"
                android:textColor="@color/chip_text" />
            <TextView
                android:id="@+id/chipQibla"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="@dimen/space_2"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:stateListAnimator="@animator/press"
                android:text="Кибла"
                android:textAppearance="@style/TextAppearance.G.Label"
                android:textColor="@color/chip_text" />
            <TextView
                android:id="@+id/chipPlace"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:stateListAnimator="@animator/press"
                android:text="Место"
                android:textAppearance="@style/TextAppearance.G.Label"
                android:textColor="@color/chip_text" />
        </LinearLayout>

        <app.okmap.CompassView
            android:id="@+id/compassView"
            android:layout_width="match_parent"
            android:layout_height="248dp"
            android:layout_marginTop="@dimen/space_2" />

        <TextView
            android:id="@+id/cTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.G.Title"
            android:textColor="?attr/gTextPrimary" />

        <TextView
            android:id="@+id/cInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.G.BodySmall"
            android:textColor="?attr/gTextSecondary" />

        <TextView
            android:id="@+id/cGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.G.Label"
            android:textColor="?attr/gAccent"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/cWarn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.G.Caption"
            android:textColor="?attr/gCrosshair"
            android:visibility="gone" />

        <TextView
            android:id="@+id/cCal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/control_sm"
            android:textAppearance="@style/TextAppearance.G.Caption"
            android:textColor="?attr/gTextSecondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_6"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:indeterminateTint="?attr/gAccent" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center"
            android:text="@string/loading"
            android:textAppearance="@style/TextAppearance.G.Body"
            android:textColor="?attr/gTextSecondary" />
    </LinearLayout>
</FrameLayout>
